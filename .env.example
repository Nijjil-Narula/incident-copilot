# .env.example
# Incident Copilot — environment variable template.
# Copy this file to .env and fill in real values. Never commit .env to git.

# ── Company display name ────────────────────────────────────────────────────
# Shown in the UI header. No code paths depend on this value.
COMPANY_NAME=Your Company

# ── LLM provider ───────────────────────────────────────────────────────────
# Supported: gemini | ollama
LLM_PROVIDER=gemini

# Gemini (default)
# Gemini API key. NEVER logged or returned via the API.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=4096
LLM_TEMPERATURE=0.1
POSTMORTEM_MAX_OUTPUT_TOKENS=4096
POSTMORTEM_TIMEOUT_S=90

# Ollama (optional offline fallback — runs on the Windows host, not in Docker)
OLLAMA_BASE_URL=http://host.docker.internal:11434

# ── Embedding model ─────────────────────────────────────────────────────────
# HuggingFace model id. Runs locally; docs never leave this machine.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_QUERY_PREFIX=
RETRIEVAL_K=6
RETRIEVAL_MIN_SCORE=0.45

# ── PostgreSQL ──────────────────────────────────────────────────────────────
# The api derives its DATABASE_URL from these individual variables at runtime.
# Do not add a separate DATABASE_URL here — it would create two conflicting sources.
POSTGRES_USER=copilot_user
POSTGRES_PASSWORD=
POSTGRES_DB=incident_copilot
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
ANSWER_CACHE_TTL_S=86400

# ── LangSmith observability ─────────────────────────────────────────────────
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=incident-copilot

# ── Abuse & Rate Limits (in-memory, global) ──────────────────────────────────
# Max operations per minute across the application (relies on single uvicorn worker).
RATE_ASK_PER_MIN=30
RATE_RESOLVE_PER_MIN=5
RATE_UPLOAD_PER_MIN=10
# Maximum real LLM calls per day (resets at 00:00 UTC).
# Cache hits and no_context answers do NOT count toward this cap.
DAILY_LLM_CALL_CAP=500

# ── Service memory limits (Docker deploy.resources.limits.memory) ───────────
# NOTE: The api container needs ~2 GB once the HuggingFace embedding model
# (BAAI/bge-small-en-v1.5, ~130 MB weights + runtime overhead) is loaded in Step 2.
# Reduce API_MEM_LIMIT only if you are sure the model will not be loaded.
API_MEM_LIMIT=2g
UI_MEM_LIMIT=512m
REDIS_MEM_LIMIT=256m
POSTGRES_MEM_LIMIT=512m

# ── Published host ports (bound to 127.0.0.1 — local access only) ───────────
API_HOST_PORT=8000
UI_HOST_PORT=8501

# ── Production reverse proxy & authentication (Caddy) ──────────────────────
# Domain for automated HTTPS (e.g. copilot.yourdomain.com or my-app.duckdns.org).
# Use 'localhost' for local testing (Caddy will generate an internal self-signed cert).
DOMAIN=localhost

# HTTP Basic Auth credentials for Caddy.
# Generate the password hash with:
#   docker run --rm caddy:2.8.4-alpine caddy hash-password
#
# IMPORTANT GOTCHA:
# A bcrypt hash contains "$" characters (e.g. $2a$14$...). Docker Compose interpolates
# unescaped "$" symbols in .env as environment variable lookups, which corrupts the hash.
# You MUST wrap the hash value in single quotes in .env (or escape every "$" as "$$").
BASIC_AUTH_USER=admin
BASIC_AUTH_HASH='$2a$14$REPLACE_WITH_REAL_HASH_FROM_caddy_hash-password'


